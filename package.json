{
  "name": "@easyeda-copilot/router",
  "version": "0.1.0",
  "description": "EDA-neutral PCB routing orchestration for KiCad Routing Tools",
  "type": "module",
  "license": "MIT",
  "main": "./package-dist/index.js",
  "types": "./package-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    },
    "./dsl": {
      "types": "./package-dist/intent/index.d.ts",
      "import": "./package-dist/intent/index.js"
    },
    "./schema": {
      "types": "./package-dist/schema.d.ts",
      "import": "./package-dist/schema.js"
    },
    "./core": {
      "types": "./package-dist/core/index.d.ts",
      "import": "./package-dist/core/index.js"
    },
    "./adapters/contracts": {
      "types": "./package-dist/adapters/contracts.d.ts",
      "import": "./package-dist/adapters/contracts.js"
    },
    "./adapters/kicad": {
      "types": "./package-dist/adapters/kicad.d.ts",
      "import": "./package-dist/adapters/kicad.js"
    },
    "./backends/assets": {
      "types": "./package-dist/backends/assets.d.ts",
      "import": "./package-dist/backends/assets.js"
    },
    "./backends/krt": {
      "types": "./package-dist/backends/krt.d.ts",
      "import": "./package-dist/backends/krt.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "copilot-router": "./package-dist/cli.js"
  },
  "files": [
    "package-dist",
    "assets/krt-patches",
    "docs",
    "README.md",
    "README-package.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:public",
    "build:public": "tsup src/index.ts src/intent/index.ts src/core/index.ts src/schema.ts src/adapters/contracts.ts src/adapters/kicad.ts src/backends/assets.ts src/backends/krt.ts src/backends/krt-codec.ts src/cli.ts --format esm --platform node --target node20 --out-dir package-dist --dts --clean --tsconfig tsconfig.public.json",
    "build:package": "npm run build:public",
    "test:package": "npm run build:package && node scripts/check-package-contract.mjs && node scripts/check-krt-codec.mjs && node scripts/check-kicad-adapter.mjs",
    "e2e:kit-dev-coldfire-xilinx_5213": "npm run build:package && node tests/e2e/kit-dev-coldfire-xilinx_5213/run.mjs",
    "e2e:sonde_u": "npm run build:package && node tests/e2e/sonde_u/run.mjs",
    "e2e:powerbank": "npm run build:package && node tests/e2e/powerbank/run.mjs",
    "e2e:band-amp": "npm run build:package && node tests/e2e/band_amp/run.mjs",
    "e2e:krt-corpus": "npm run build:package && node tests/e2e/_corpora/kicad-routing-tools/run.mjs",
    "test:e2e:krt-corpus:contract": "npm run build:package && node scripts/check-kicad-routing-tools-corpus.mjs",
    "test:powerbank:polygon": "npm run build && node scripts/check-powerbank-polygon-search.mjs",
    "test:band-amp:polygon": "npm run build && node scripts/check-band-amp-polygon-search.mjs",
    "test": "npm run test:package",
    "e2e:no-kicad:portable": "npm run build:package && node tests/e2e/no_kicad/portable.mjs",
    "e2e:no-kicad:polygon": "npm run build:package && node scripts/check-powerbank-polygon-search.mjs && node scripts/check-band-amp-polygon-search.mjs",
    "e2e:no-kicad:krt": "npm run build:package && node tests/e2e/no_kicad/krt.mjs",
    "e2e:no-kicad:native": "npm run build:package && node tests/e2e/no_kicad/native.mjs",
    "e2e:no-kicad:packed": "node tests/e2e/no_kicad/packed.mjs",
    "e2e:no-kicad": "npm run e2e:no-kicad:portable && npm run e2e:no-kicad:polygon && npm run e2e:no-kicad:krt && npm run e2e:no-kicad:native && npm run e2e:no-kicad:packed",
    "prepack": "npm run build:package",
    "e2e:cap_chain": "npm run build:package && node tests/e2e/cap_chain/run.mjs",
    "e2e:esp_prog": "npm run build:package && node tests/e2e/esp_prog/run.mjs",
    "e2e:flat_hierarchy": "npm run build:package && node tests/e2e/flat_hierarchy/run.mjs",
    "e2e:glasgow_revC": "npm run build:package && node tests/e2e/glasgow_revC/run.mjs",
    "e2e:haasoscope_pro_max_test": "npm run build:package && node tests/e2e/haasoscope_pro_max_test/run.mjs",
    "e2e:interf_u_unrouted": "npm run build:package && node tests/e2e/interf_u_unrouted/run.mjs",
    "e2e:interf_u_unrouted_placed": "npm run build:package && node tests/e2e/interf_u_unrouted_placed/run.mjs",
    "e2e:lvds_converter_dualclk": "npm run build:package && node tests/e2e/lvds_converter_dualclk/run.mjs",
    "e2e:lvds_converter_dualclk_gnd": "npm run build:package && node tests/e2e/lvds_converter_dualclk_gnd/run.mjs",
    "e2e:orangecrab_ext_pll": "npm run build:package && node tests/e2e/orangecrab_ext_pll/run.mjs",
    "e2e:qfn_csi_underpad_diff": "npm run build:package && node tests/e2e/qfn_csi_underpad_diff/run.mjs",
    "e2e:qfn_diffpair_escape": "npm run build:package && node tests/e2e/qfn_diffpair_escape/run.mjs",
    "e2e:qfn_interior_pads": "npm run build:package && node tests/e2e/qfn_interior_pads/run.mjs",
    "e2e:qfn_underpad_coupling": "npm run build:package && node tests/e2e/qfn_underpad_coupling/run.mjs",
    "e2e:routed_output": "npm run build:package && node tests/e2e/routed_output/run.mjs",
    "e2e:rp2350_fpga_eensy_prePlane": "npm run build:package && node tests/e2e/rp2350_fpga_eensy_prePlane/run.mjs",
    "e2e:splitflap_driver": "npm run build:package && node tests/e2e/splitflap_driver/run.mjs",
    "e2e:tigard": "npm run build:package && node tests/e2e/tigard/run.mjs",
    "e2e:ulx3s": "npm run build:package && node tests/e2e/ulx3s/run.mjs",
    "e2e:watchy": "npm run build:package && node tests/e2e/watchy/run.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "clipper-lib": "^6.4.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
